{
  "name": "ContentItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title or caption for this content item"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "photo",
        "story",
        "press_clipping",
        "video",
        "audio",
        "certificate",
        "narrative",
        "passport",
        "identity_document",
        "correspondence",
        "memorial",
        "uncategorized"
      ],
      "default": "photo",
      "description": "Type of content \u2014 'uncategorized' is used when the AI cannot confidently classify the image"
    },
    "ancestor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of ancestors tagged in this item"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date associated with this content"
    },
    "location_name": {
      "type": "string",
      "description": "Place name where this content is set"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude for map pin"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude for map pin"
    },
    "description": {
      "type": "string",
      "description": "Description or caption"
    },
    "historical_background": {
      "type": "string",
      "description": "AI-generated historical background narrative \u2014 researched via web search using extracted data (locations, institutions, dates, occupations, migration context). Written in the style of a ghost writer constructing a personal history biography for the tagged ancestor(s)."
    },
    "historical_background_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of when the historical background was last generated"
    },
    "transcribed_text": {
      "type": "string",
      "description": "OCR transcription of narrative documents"
    },
    "extracted_fields": {
      "type": "object",
      "description": "Fields extracted from certificates by AI"
    },
    "raw_ai_analysis": {
      "type": "object",
      "description": "Full unstructured AI analysis output \u2014 stored for admin search and future pattern learning"
    },
    "ai_confidence": {
      "type": "number",
      "description": "AI confidence score (0-1) for the content classification"
    },
    "categorization_notes": {
      "type": "string",
      "description": "AI's reasoning for the classification, including uncertainty and visual elements that led to the conclusion"
    },
    "visual_elements": {
      "type": "object",
      "description": "All visual elements extracted by AI \u2014 objects, people, text, dates, locations, format, era indicators, notable features",
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dates_visible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations_visible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format_description": {
          "type": "string"
        },
        "era_indicators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notable_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "focal_point_x": {
      "type": "number",
      "description": "AI-determined focal point X coordinate (0-1, 0=left, 0.5=center, 1=right). Used by CSS object-position to crop images perfectly on card thumbnails and hero displays.",
      "default": 0.5
    },
    "focal_point_y": {
      "type": "number",
      "description": "AI-determined focal point Y coordinate (0-1, 0=top, 0.5=center, 1=bottom). Used by CSS object-position to crop images perfectly on card thumbnails and hero displays.",
      "default": 0.5
    },
    "file_url": {
      "type": "string",
      "description": "URL to uploaded media file"
    },
    "external_url": {
      "type": "string",
      "description": "External URL for video (YouTube/Vimeo)"
    },
    "era": {
      "type": "string",
      "description": "Historical era or time period"
    },
    "uploaded_by_id": {
      "type": "string",
      "description": "User ID of uploader"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch this content originated from"
    },
    "conflict_flag_status": {
      "type": "string",
      "enum": [
        "none",
        "open",
        "resolved",
        "dismissed"
      ],
      "default": "none",
      "description": "Conflict flag status"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "flagged"
      ],
      "default": "pending",
      "description": "Admin review status for this uploaded content"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional tags"
    }
  },
  "required": [
    "title",
    "content_type"
  ]
}