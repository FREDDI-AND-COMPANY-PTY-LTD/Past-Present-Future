{
  "name": "Branch",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the branch (e.g. family surname line)"
    },
    "founder_id": {
      "type": "string",
      "description": "User ID of the member who started this branch"
    },
    "admin_user_id": {
      "type": "string",
      "description": "User ID of the branch admin \u2014 the sole authority over this branch's data (edit, delete, approve uploads, grant/block access). Set when a member claims/creates the branch."
    },
    "is_claimed": {
      "type": "boolean",
      "default": false,
      "description": "True once a member has claimed admin of this branch"
    },
    "ancestor_id": {
      "type": "string",
      "description": "Ancestor node this branch stems from \u2014 the senior-most ancestor of the line; the branch shows all descendants of this ancestor"
    },
    "accent_color": {
      "type": "string",
      "description": "Hex colour for this branch's accent"
    },
    "description": {
      "type": "string",
      "description": "Description of the branch"
    },
    "newsletter_frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ],
      "default": "monthly",
      "description": "How often this branch's family newsletter is generated. Set by the branch admin; defaults to monthly."
    },
    "activation_status": {
      "type": "string",
      "enum": [
        "active",
        "pending_acknowledgment",
        "declined"
      ],
      "default": "active",
      "description": "Activation state. An additional bloodline joined to an existing branch by marriage is created as 'pending_acknowledgment' and only becomes 'active' once BOTH branch admins have acknowledged the marriage connection (two-admin mutual agreement). 'declined' = the connected branch's admin declined the connection."
    },
    "connected_by_marriage_to_branch_id": {
      "type": "string",
      "description": "When this branch was created as a bloodline joined by marriage, the existing branch it connects to. Two-admin mutual acknowledgment is required to activate."
    },
    "connected_by_marriage_to_branch_name": {
      "type": "string",
      "description": "Denormalised name of the connected branch at creation time"
    },
    "requester_acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "True once the creating branch admin checked the marriage-connection acknowledgment box"
    },
    "requester_acknowledged_by_id": {
      "type": "string",
      "description": "User ID of the creating admin who acknowledged"
    },
    "requester_acknowledged_by_name": {
      "type": "string",
      "description": "Display name of the creating admin who acknowledged"
    },
    "spouse_acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "True once the connected (marriage) branch's admin acknowledged the connection \u2014 completes two-admin activation"
    },
    "spouse_acknowledged_by_id": {
      "type": "string",
      "description": "User ID of the connected branch's admin who acknowledged"
    },
    "spouse_acknowledged_by_name": {
      "type": "string",
      "description": "Display name of the connected branch's admin who acknowledged"
    },
    "spouse_acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the connected branch's admin acknowledged (or declined) the connection"
    },
    "cloud_provider": {
      "type": "string",
      "enum": [
        "google_drive",
        "one_drive",
        "dropbox"
      ],
      "default": "google_drive",
      "description": "Cloud storage provider this branch's archive backs up to. Branch-scoped so each branch admin controls their own line's backup destination \u2014 important for RLS, where each admin only governs their own branch's data."
    },
    "cloud_folder_address": {
      "type": "string",
      "description": "Folder path in the cloud provider where this branch's archive is backed up. Set by the branch admin at confirmation time."
    },
    "transfer_request": {
      "type": "object",
      "description": "A courtesy offer to transfer branch admin to an elder (senior living male) ancestor in the bloodline. The first member to register is a placeholder steward who may invite a more senior living male to take on the role; this is a courtesy, not an obligation, and the successor may decline \u2014 leaving the current admin in place.",
      "properties": {
        "to_user_id": {
          "type": "string",
          "description": "User ID of the invited successor"
        },
        "to_user_name": {
          "type": "string",
          "description": "Display name of the invited successor"
        },
        "to_ancestor_id": {
          "type": "string",
          "description": "Ancestor profile ID of the invited successor"
        },
        "to_ancestor_name": {
          "type": "string",
          "description": "Full name of the invited successor ancestor"
        },
        "from_user_id": {
          "type": "string",
          "description": "User ID of the admin proposing the transfer"
        },
        "from_user_name": {
          "type": "string",
          "description": "Display name of the admin proposing the transfer"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "declined"
          ],
          "description": "pending = invitation sent, awaiting the elder's response; accepted = admin transferred; declined = elder declined"
        },
        "invited_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the transfer invitation was sent"
        },
        "responded_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the elder accepted or declined"
        },
        "message": {
          "type": "string",
          "description": "Optional note from the current admin to the successor"
        }
      }
    }
  },
  "required": [
    "name"
  ]
}