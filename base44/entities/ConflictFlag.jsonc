{
  "name": "ConflictFlag",
  "type": "object",
  "properties": {
    "content_item_id": {
      "type": "string",
      "description": "ID of the content item being disputed"
    },
    "ancestor_id": {
      "type": "string",
      "description": "ID of the ancestor profile being disputed, if applicable"
    },
    "field_name": {
      "type": "string",
      "description": "Which field or data point is disputed"
    },
    "flag_type": {
      "type": "string",
      "enum": [
        "dispute",
        "duplicate_upload",
        "contested"
      ],
      "default": "dispute",
      "description": "Type of conflict flag \u2014 'dispute' for data disagreements, 'duplicate_upload' for potential duplicate content, 'contested' for fields where the correct value is uncertain after merge resolution"
    },
    "duplicate_of_content_item_id": {
      "type": "string",
      "description": "When flag_type is 'duplicate_upload' \u2014 ID of the existing content item that this upload may duplicate"
    },
    "duplicate_of_content_item_title": {
      "type": "string",
      "description": "Title of the existing content item that this upload may duplicate"
    },
    "duplicate_confidence": {
      "type": "number",
      "description": "AI confidence score (0-1) for the duplicate detection"
    },
    "competing_values": {
      "type": "object",
      "description": "Stores the competing data values that led to the contested flag, e.g. { 'your_upload': 'Melbourne', 'existing_item': 'Sydney' }",
      "properties": {}
    },
    "raised_by_id": {
      "type": "string",
      "description": "User ID of the person raising the flag"
    },
    "raised_by_name": {
      "type": "string",
      "description": "Display name of the person raising the flag"
    },
    "dispute_description": {
      "type": "string",
      "description": "Description of what is disputed and the correct information"
    },
    "supporting_file_url": {
      "type": "string",
      "description": "Optional supporting document"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "dismissed"
      ],
      "default": "open",
      "description": "Status of the conflict flag"
    },
    "resolution_note": {
      "type": "string",
      "description": "Note from Elder/Admin on resolution"
    },
    "resolved_by_id": {
      "type": "string",
      "description": "User ID of the resolver"
    },
    "bloodline": {
      "type": "string",
      "description": "Bloodline this conflict belongs to"
    }
  },
  "required": [
    "dispute_description",
    "status"
  ]
}