{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 * * 1",
      "one_time_date": null,
      "timezone": "Australia/Sydney",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_branch_duplicate_scan_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scheduledBranchDuplicateAlerts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Scan bloodlines for duplicates",
            "description": "Runs the duplicate scan and flags new pairs"
          }
        }
      }
    ]
  },
  "description": "Every Monday morning, scans each administered branch's bloodline for duplicate content and raises a task for the branch admin when new duplicate pairs are found (persisted as open conflict flags so they aren't re-reported).",
  "name": "Weekly Branch Duplicate Scan & Alert"
}