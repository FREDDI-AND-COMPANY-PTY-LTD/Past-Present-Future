{
  "name": "GoLiveSession",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending",
      "description": "Tracks the going-live review process. pending = task shown in admin task list; in_progress = admin is reviewing events via swipe; completed = going live done, invite workflow triggered"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch this session is scoped to. Null/absent = the global admin going-live review (all branches). When set, the session and its completion milestone belong to a single branch admin's line."
    },
    "total_items": {
      "type": "number",
      "description": "Total items in the review session"
    },
    "confirmed_count": {
      "type": "number",
      "default": 0,
      "description": "Items confirmed via swipe right"
    },
    "flagged_count": {
      "type": "number",
      "default": 0,
      "description": "Items flagged for further review via swipe left"
    },
    "started_by_id": {
      "type": "string",
      "description": "Admin user ID who started the review"
    },
    "started_by_name": {
      "type": "string",
      "description": "Admin display name who started the review"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the going-live review was completed"
    }
  },
  "required": [
    "status"
  ]
}