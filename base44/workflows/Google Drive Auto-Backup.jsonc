{
  "name": "Google Drive Auto-Backup",
  "description": "Automatically backs up uploaded photos, videos, and documents to the shared Freddi Ancestry Archive Google Drive folder whenever a family member saves a new event.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ContentItem"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_drive_auto_backup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backupToDrive",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "backupToDrive"
  }
}