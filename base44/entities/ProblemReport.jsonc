{
  "name": "ProblemReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title summarizing the problem"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the problem reported by the user"
    },
    "source": {
      "type": "string",
      "enum": [
        "user_report",
        "branch_admin_request",
        "ai_handoff"
      ],
      "default": "user_report",
      "description": "Origin of the report \u2014 user_report = a family member hit a snag; branch_admin_request = a branch admin escalating to the global admin (stuck/jammed, unresolvable AI proposal, etc.); ai_handoff = the AI assistant couldn't resolve something and handed it off"
    },
    "category": {
      "type": "string",
      "enum": [
        "general_problem",
        "dispute_between_bloodlines",
        "dispute_branch_authority",
        "appeal_global_admin"
      ],
      "default": "general_problem",
      "description": "Reporting category \u2014 the intake structure for the Contact Admin tasks. 'dispute_between_bloodlines' = a disagreement between two bloodlines (e.g. over a shared record or marriage connection); 'dispute_branch_authority' = a dispute over a branch admin's role or authority; 'appeal_global_admin' = a user appealing to the global admin of the family complex for resolution."
    },
    "branch_id": {
      "type": "string",
      "description": "For branch_admin_request source \u2014 the branch this escalation came from"
    },
    "branch_name": {
      "type": "string",
      "description": "Denormalised branch name at time of escalation"
    },
    "connected_branch_id": {
      "type": "string",
      "description": "For a dispute_between_bloodlines report \u2014 the other branch involved in the dispute"
    },
    "connected_branch_name": {
      "type": "string",
      "description": "Denormalised name of the connected branch at report time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "default": "open",
      "description": "Current status of the problem report"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Priority level assigned by admin"
    },
    "reported_by_id": {
      "type": "string",
      "description": "User ID of the person reporting the problem"
    },
    "reported_by_name": {
      "type": "string",
      "description": "Display name of the reporter"
    },
    "admin_response": {
      "type": "string",
      "description": "Admin's response or resolution notes"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "open",
        "later",
        "resolved",
        "dismissed"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "gray"
      ],
      "default": "open",
      "description": "Shared review lifecycle used by the Review page \u2014 independent of 'status', which keeps its existing meaning"
    },
    "review_note": {
      "type": "string",
      "description": "Review note recorded against the shared review lifecycle"
    },
    "reviewed_by_id": {
      "type": "string",
      "description": "User ID of the person who last moved this record through the review lifecycle"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was last moved through the review lifecycle"
    }
  },
  "required": [
    "title",
    "description",
    "status"
  ]
}