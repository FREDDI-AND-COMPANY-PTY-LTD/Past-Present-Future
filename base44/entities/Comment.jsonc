{
  "name": "Comment",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "description": "Type of entity this comment relates to"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the entity"
    },
    "field_name": {
      "type": "string",
      "description": "Field name this comment relates to"
    },
    "author_id": {
      "type": "string",
      "description": "User ID of the commenter"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of the commenter"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    },
    "parent_comment_id": {
      "type": "string",
      "description": "ID of parent comment for threaded replies (null if top-level)"
    },
    "related_content_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of ContentItems uploaded as related events in response to this comment"
    },
    "tagged_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs tagged in this comment \u2014 they receive a notification and the comment appears in their Tasks area"
    },
    "is_query": {
      "type": "boolean",
      "default": false,
      "description": "Whether this comment is a query/question rather than a statement"
    },
    "acknowledged_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs who have acknowledged/dismissed this comment from their Tasks area"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "field_name",
    "content"
  ]
}