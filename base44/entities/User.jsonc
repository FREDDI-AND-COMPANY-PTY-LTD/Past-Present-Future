{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "elder"
      ]
    },
    "login_count": {
      "type": "number",
      "description": "Number of times the user has logged in (tracked for onboarding helpers)",
      "default": 0
    },
    "newsletter_opt_in": {
      "type": "boolean",
      "description": "Whether the user has opted in to receive the monthly newsletter",
      "default": false
    },
    "given_names": {
      "type": "string",
      "description": "Given / first names as they appear on the birth certificate (e.g. Jason Lewis)"
    },
    "family_name": {
      "type": "string",
      "description": "Surname / family name as capitalised on the birth certificate (e.g. FREDDI)"
    },
    "residence_place": {
      "type": "string",
      "description": "Town/city where this user currently lives (town-level only for privacy). Captured at registration, propagated to the user's Ancestor profile during onboarding."
    },
    "residence_latitude": {
      "type": "number",
      "description": "Latitude of the residence town center"
    },
    "residence_longitude": {
      "type": "number",
      "description": "Longitude of the residence town center"
    },
    "last_notification_check": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of when the user last concluded their notification review"
    },
    "cloud_folder_address": {
      "type": "string",
      "description": "Cloud folder path for automatic archive backups (entered when upgrading to a Branch Member)"
    },
    "cloud_provider": {
      "type": "string",
      "enum": [
        "google_drive",
        "one_drive",
        "dropbox"
      ],
      "description": "Which cloud storage provider the branch member uses for monthly archive backups"
    },
    "is_branch_member": {
      "type": "boolean",
      "description": "Whether the user has upgraded to a Branch Member subscription",
      "default": false
    },
    "admin_branch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of branches this user is the admin of. Denormalised from Branch.admin_user_id so RLS can gate writes by branch_id without a join. Synced by the syncUserAdminBranches backend function whenever a branch is claimed or transferred.",
      "default": []
    }
  },
  "required": [
    "role"
  ]
}