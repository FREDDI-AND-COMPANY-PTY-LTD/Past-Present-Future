{
  "name": "ContentItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title or caption for this content item"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "photo",
        "story",
        "press_clipping",
        "video",
        "audio",
        "certificate",
        "narrative",
        "passport",
        "identity_document",
        "correspondence",
        "memorial",
        "uncategorized"
      ],
      "default": "photo",
      "description": "Type of content \u2014 'uncategorized' is used when the AI cannot confidently classify the image"
    },
    "ancestor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of ancestors tagged in this item"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the EVENT itself took place (e.g. date of birth, the historic event, the day a photo was taken) \u2014 NOT the date the document was issued or published"
    },
    "location_name": {
      "type": "string",
      "description": "Place where the EVENT took place (e.g. where a photo was taken, where a birth was registered) \u2014 NOT where the document was issued or published"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude for the event location map pin"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude for the event location map pin"
    },
    "publication_date": {
      "type": "string",
      "format": "date",
      "description": "Date the document/record was ISSUED or PUBLISHED (e.g. a certificate's date of issue, a newspaper's publication date, an interview's recording date) \u2014 distinct from the event date above. Only applies to document-shaped content types."
    },
    "publication_location_name": {
      "type": "string",
      "description": "Place where the document/record was issued or published (e.g. the registry office city, the newspaper's city of publication) \u2014 distinct from the event location above"
    },
    "publication_latitude": {
      "type": "number",
      "description": "Latitude for the publication/issue location"
    },
    "publication_longitude": {
      "type": "number",
      "description": "Longitude for the publication/issue location"
    },
    "description": {
      "type": "string",
      "description": "Description or caption"
    },
    "historical_background": {
      "type": "string",
      "description": "AI-generated historical background narrative \u2014 researched via web search using extracted data (locations, institutions, dates, occupations, migration context). Written in the style of a ghost writer constructing a personal history biography for the tagged ancestor(s)."
    },
    "historical_background_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of when the historical background was last generated"
    },
    "transcribed_text": {
      "type": "string",
      "description": "OCR transcription of narrative documents"
    },
    "english_translation": {
      "type": "string",
      "description": "AI-generated English translation of transcribed_text \u2014 persisted so it displays permanently in event details"
    },
    "translation_language": {
      "type": "string",
      "description": "Detected source language of the transcribed text"
    },
    "narrative_extraction": {
      "type": "object",
      "description": "Structured analysis of the body of text (transcribed text, narrative, article, interview) tuned for the chronicle/newsletter. Extracted by the analyzeContentText function: the event the text describes, everyone named, every place named, and a ready-to-paste chronicle snippet.",
      "properties": {
        "event_date": {
          "type": "string",
          "description": "The date the described event occurred (ISO date when determinable, otherwise free text)"
        },
        "event_date_display": {
          "type": "string",
          "description": "Human-readable event date label (e.g. 'circa 1948', 'summer of 1953', '14 March 1956')"
        },
        "event_description": {
          "type": "string",
          "description": "1-3 sentence plain-English summary of the event the text describes"
        },
        "event_type": {
          "type": "string",
          "description": "Category of the event (birth, marriage, death, migration, arrival, military, occupation, family gathering, travel, milestone, other)"
        },
        "named_people": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "relationship": {
                "type": "string"
              }
            }
          },
          "description": "Everyone named in the body \u2014 ancestors AND other people"
        },
        "named_places": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "place": {
                "type": "string"
              },
              "context": {
                "type": "string"
              }
            }
          },
          "description": "Every place named, with context (e.g. 'born in', 'arrived at', 'married in')"
        },
        "chronicle_snippet": {
          "type": "string",
          "description": "A ready-to-paste 1-2 sentence line for a newsletter/chronicle entry summarising this item"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "When this narrative extraction was generated"
        }
      }
    },
    "extracted_fields": {
      "type": "object",
      "description": "Fields extracted from certificates by AI"
    },
    "raw_ai_analysis": {
      "type": "object",
      "description": "Full unstructured AI analysis output \u2014 stored for admin search and future pattern learning"
    },
    "ai_confidence": {
      "type": "number",
      "description": "AI confidence score (0-1) for the content classification"
    },
    "categorization_notes": {
      "type": "string",
      "description": "AI's reasoning for the classification, including uncertainty and visual elements that led to the conclusion"
    },
    "visual_elements": {
      "type": "object",
      "description": "All visual elements extracted by AI \u2014 objects, people, text, dates, locations, format, era indicators, notable features",
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dates_visible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations_visible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format_description": {
          "type": "string"
        },
        "era_indicators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notable_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "focal_point_x": {
      "type": "number",
      "description": "AI-determined focal point X coordinate (0-1, 0=left, 0.5=center, 1=right). Used as the centre tie-breaker when the crop window is larger than the subject region.",
      "default": 0.5
    },
    "focal_point_y": {
      "type": "number",
      "description": "AI-determined focal point Y coordinate (0-1, 0=top, 0.5=center, 1=bottom). Used as the centre tie-breaker when the crop window is larger than the subject region.",
      "default": 0.4
    },
    "shot_type": {
      "type": "string",
      "enum": [
        "closeup",
        "portrait",
        "mid_shot",
        "long_shot",
        "group_photo",
        "document",
        "landscape"
      ],
      "description": "AI-detected shot type \u2014 determines how the image is cropped when thumbnailed. closeup/portrait = face is focal; mid_shot = upper body; long_shot = full scene; group_photo = center of group; document = text/heading area; landscape = center of scene."
    },
    "crop_bounds": {
      "type": "object",
      "description": "Inner content frame for 'photo within a photo' scenarios \u2014 when the actual image content is a sub-region of the full image (e.g., a scanned photo with white borders, a framed picture, a photo on a scanner bed). The card thumbnail zooms into this area before applying the focal point. When null or near-full-frame, the full image is used.",
      "properties": {
        "x_min": {
          "type": "number",
          "description": "Left edge of content area (0-1)"
        },
        "y_min": {
          "type": "number",
          "description": "Top edge of content area (0-1)"
        },
        "x_max": {
          "type": "number",
          "description": "Right edge of content area (0-1)"
        },
        "y_max": {
          "type": "number",
          "description": "Bottom edge of content area (0-1)"
        }
      }
    },
    "subject_bounds": {
      "type": "object",
      "description": "AI-detected subject region \u2014 the single bounding box that encloses ALL of the image's important content (every visible person's face AND body, or the salient object/text block). The renderer frames this entire region inside any crop aspect ratio (square, 16:9, 9:16, 4:3) so heads and bodies are never decapitated. The focal point is used only as a centre tie-breaker when the crop window is larger than the subject. Null for legacy records (pre-smart-crop) or when a human manually overrides the crop \u2014 those fall back to focal-point framing. Coordinates are relative to the FULL image (0-1), inside the crop_bounds.",
      "properties": {
        "x_min": {
          "type": "number",
          "description": "Left edge of subject region (0-1)"
        },
        "y_min": {
          "type": "number",
          "description": "Top edge of subject region (0-1)"
        },
        "x_max": {
          "type": "number",
          "description": "Right edge of subject region (0-1)"
        },
        "y_max": {
          "type": "number",
          "description": "Bottom edge of subject region (0-1)"
        }
      }
    },
    "file_url": {
      "type": "string",
      "description": "URL to uploaded media file"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Preview thumbnail image URL for non-image documents (e.g. PDFs). Generated by rendering the document's first page to an image so cards and detail views show a visual preview instead of a broken image or generic icon."
    },
    "external_url": {
      "type": "string",
      "description": "External URL for video (YouTube/Vimeo)"
    },
    "era": {
      "type": "string",
      "description": "Historical era or time period"
    },
    "uploaded_by_id": {
      "type": "string",
      "description": "User ID of uploader"
    },
    "parent_content_item_id": {
      "type": "string",
      "description": "When this item was uploaded as a 'related event' from within another event's discussion, this holds the parent ContentItem ID. Such items are viewable ONLY from within their parent event (the Engage / Add Related Event area) and are excluded from the Timeline, Map, ancestor galleries, Home feed, and admin review queue \u2014 they are never treated as standalone events."
    },
    "branch_id": {
      "type": "string",
      "description": "Branch this content originated from"
    },
    "conflict_flag_status": {
      "type": "string",
      "enum": [
        "none",
        "open",
        "resolved",
        "dismissed"
      ],
      "default": "none",
      "description": "Conflict flag status"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "flagged"
      ],
      "default": "pending",
      "description": "Admin review status for this uploaded content"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional tags"
    }
  },
  "required": [
    "title",
    "content_type"
  ]
}