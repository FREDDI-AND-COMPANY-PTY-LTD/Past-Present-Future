{
  "name": "Ancestor",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Full name of the ancestor"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "description": "Biological sex of the ancestor. The branch/bloodline follows the male line of descent (the surname carried by sons); a female ancestor belongs to her husband's branch by marriage, but her maiden_name links back to her birth (father's) branch."
    },
    "maiden_name": {
      "type": "string",
      "description": "Birth surname for female ancestors \u2014 the surname of her father, identifying the branch she was born into. Used to link a married-in ancestor back to her own family's branch in the archive."
    },
    "branch_id": {
      "type": "string",
      "description": "The branch this ancestor belongs to. Set when an ancestor is created via branch nomination or assigned to a branch. Used with the branch-admin model so each line's records are owned and governed by that branch's admin."
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "birth_place": {
      "type": "string",
      "description": "Place of birth (city, country)"
    },
    "death_date": {
      "type": "string",
      "format": "date",
      "description": "Date of death, if deceased"
    },
    "death_place": {
      "type": "string",
      "description": "Place of death, if applicable"
    },
    "residence_place": {
      "type": "string",
      "description": "Town/city where this ancestor currently lives (living members only). Town-level only \u2014 no street addresses \u2014 for privacy. Captured at registration, propagated to the ancestor profile during onboarding, and editable from the profile. Drives the 'where the family is today' map layer."
    },
    "residence_latitude": {
      "type": "number",
      "description": "Latitude of the residence town center (town-level precision only \u2014 no street-level coordinates)"
    },
    "residence_longitude": {
      "type": "number",
      "description": "Longitude of the residence town center (town-level precision only \u2014 no street-level coordinates)"
    },
    "nationality": {
      "type": "string",
      "description": "Nationality or country of origin"
    },
    "biography": {
      "type": "string",
      "description": "Brief biography"
    },
    "ai_biography": {
      "type": "string",
      "description": "AI-generated 2-3 paragraph overview synthesising what is known about this ancestor \u2014 tagged events, documents, family context, and historical background. Regenerable to incorporate newly added material."
    },
    "ai_biography_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the AI biography was last generated"
    },
    "bloodline": {
      "type": "string",
      "description": "Bloodline or family line name"
    },
    "living": {
      "type": "boolean",
      "default": true,
      "description": "Whether this ancestor is currently living"
    },
    "profile_photo": {
      "type": "string",
      "description": "Portrait photo URL"
    },
    "birth_certificate": {
      "type": "string",
      "description": "Birth certificate file URL"
    },
    "marriage_certificate": {
      "type": "string",
      "description": "Marriage certificate file URL, if applicable"
    },
    "passport_document": {
      "type": "string",
      "description": "Passport document file URL (historical/expired or current)"
    },
    "mother_id": {
      "type": "string",
      "description": "Reference to mother's Ancestor profile ID"
    },
    "father_id": {
      "type": "string",
      "description": "Reference to father's Ancestor profile ID"
    },
    "partner_id": {
      "type": "string",
      "description": "Reference to partner/spouse's Ancestor profile ID"
    },
    "era": {
      "type": "string",
      "description": "Historical era or time period"
    },
    "user_account_id": {
      "type": "string",
      "description": "If this ancestor is a registered user, their user ID"
    },
    "newsletter_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Set on an unclaimed placeholder when the inviting admin requested auto-subscription to the family newsletter. When the invitee registers and claims this profile, the onboarding flow copies this onto their user account."
    },
    "review_status": {
      "type": "string",
      "enum": [
        "auto_approved",
        "overwritten",
        "admin_verified",
        "staged"
      ],
      "default": "auto_approved",
      "description": "Review status \u2014 'staged' = auto-created placeholder from certificate extraction or branch nomination, hidden from family tree/map/timeline until admin-approved and integrated"
    },
    "created_by_id": {
      "type": "string",
      "description": "User ID of the family member who created this ancestor record (if user-created)"
    },
    "created_by_name": {
      "type": "string",
      "description": "Display name of the family member who created this ancestor record"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.admin_branch_ids}}"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.admin_branch_ids}}"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}