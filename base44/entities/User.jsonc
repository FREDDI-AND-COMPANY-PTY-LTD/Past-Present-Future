{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "elder"
      ]
    },
    "login_count": {
      "type": "number",
      "description": "Number of times the user has logged in (tracked for onboarding helpers)",
      "default": 0
    },
    "newsletter_opt_in": {
      "type": "boolean",
      "description": "Whether the user has opted in to receive the monthly newsletter",
      "default": false
    }
  },
  "required": [
    "role"
  ]
}