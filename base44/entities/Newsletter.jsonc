{
  "name": "Newsletter",
  "type": "object",
  "properties": {
    "headline": {
      "type": "string",
      "description": "AI-generated headline for the chronicle"
    },
    "intro": {
      "type": "string",
      "description": "Opening narrative paragraph(s)"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subheading": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "description": "Themed body sections of the newsletter story"
    },
    "closing": {
      "type": "string",
      "description": "Closing paragraph"
    },
    "month_label": {
      "type": "string",
      "description": "Human-readable period label \u2014 month for monthly chronicles (e.g. 'July 2026'), 'Week of \u2026' for weekly"
    },
    "item_count": {
      "type": "number",
      "description": "Number of content items featured in this newsletter"
    },
    "featured_item_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of ContentItem records featured in this newsletter"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of photos included in the newsletter gallery"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch this chronicle is scoped to. Chronicles are distinct per branch \u2014 each draws only from its own line's discoveries."
    },
    "branch_name": {
      "type": "string",
      "description": "Denormalised branch name at generation time"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ],
      "description": "Cadence this chronicle was generated at \u2014 mirrors the branch's newsletter_frequency"
    }
  },
  "required": [
    "headline",
    "month_label"
  ]
}