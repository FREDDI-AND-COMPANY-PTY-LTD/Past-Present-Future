{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "elder"
      ]
    },
    "login_count": {
      "type": "number",
      "description": "Number of times the user has logged in (tracked for onboarding helpers)",
      "default": 0
    },
    "newsletter_opt_in": {
      "type": "boolean",
      "description": "Whether the user has opted in to receive the monthly newsletter",
      "default": false
    },
    "given_names": {
      "type": "string",
      "description": "Given / first names as they appear on the birth certificate (e.g. Jason Lewis)"
    },
    "family_name": {
      "type": "string",
      "description": "Surname / family name as capitalised on the birth certificate (e.g. FREDDI)"
    },
    "last_notification_check": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of when the user last concluded their notification review"
    },
    "cloud_folder_address": {
      "type": "string",
      "description": "Cloud folder address for automatic archive backups (entered when upgrading to a Branch Member)"
    },
    "is_branch_member": {
      "type": "boolean",
      "description": "Whether the user has upgraded to a Branch Member subscription",
      "default": false
    }
  },
  "required": [
    "role"
  ]
}